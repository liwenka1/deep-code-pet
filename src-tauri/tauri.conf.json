{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deep-code-pet",
  "version": "0.0.2",
  "identifier": "dev.deepcode.pet",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "deep-code-pet",
        "width": 150,
        "height": 162,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "chat",
        "title": "deep-code-pet",
        "url": "chat.html",
        "width": 420,
        "height": 560,
        "minWidth": 320,
        "minHeight": 380,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      },
      {
        "label": "history",
        "title": "历史对话",
        "url": "history.html",
        "width": 380,
        "height": 500,
        "minWidth": 300,
        "minHeight": 320,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
